{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [],
    "ask": [],
    "deny": [
      "Bash(git push --force)",
      "Bash(git push -f)",
      "Bash(git push --force-with-lease)",
      "Bash(git push --force origin master)",
      "Bash(git push --force origin master:*)",
      "Bash(git push --force origin releases/)",
      "Bash(git push --force origin releases/:*)",
      "Bash(git push -f origin master)",
      "Bash(git push -f origin master:*)",
      "Bash(git push -f origin releases/)",
      "Bash(git push -f origin releases/:*)",
      "Bash(git push --force-with-lease origin master)",
      "Bash(git push --force-with-lease origin master:*)",
      "Bash(git push --force-with-lease origin releases/)",
      "Bash(git push --force-with-lease origin releases/:*)",
      "Bash(git merge master)",
      "Bash(git merge master:*)",
      "Bash(git merge origin/master)",
      "Bash(git merge origin/master:*)",
      "Bash(git pull origin master)",
      "Bash(git pull origin master:*)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard:*)",
      "Bash(git clean)",
      "Bash(git clean:*)",
      "Bash(git branch -D:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(gh pr merge)",
      "Bash(gh pr merge:*)",
      "Bash(docker volume rm:*)",
      "Bash(docker system prune)",
      "Bash(docker system prune:*)",
      "Bash(docker compose down -v)",
      "Bash(docker compose down -v:*)",
      "Read(./.env)",
      "Read(./infrastructure/**/.env)"
    ]
  }
}
