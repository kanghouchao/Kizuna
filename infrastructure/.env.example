# このファイルは compose の変数展開に使われ、同時に backend コンテナへそのまま渡される（env_file）。
# backend の設定は Spring Boot の環境変数名で書く（プロパティ名を大文字・アンダースコアにしたもの。例: app.jwt.secret → APP_JWT_SECRET、
# spring.datasource.hikari.maximum-pool-size → SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE）。既定値は application.yml にあり、
# 書いたキーだけが上書きする。値を空にしたキーは空文字で既定値を上書きするので、使わないキーはコメントのまま残す。

APP_DOMAIN=kizuna.jp
# 業務のタイムゾーン。営業日の境界（日付変更時刻）とポイント期限の「本日」がこれで決まる。
APP_TIMEZONE=Asia/Tokyo

# 必須・既定値なし。HS256 の鍵として UTF-8 で 32 バイト以上
APP_JWT_SECRET=${APP_JWT_SECRET:-replace-with-a-secure-random-value}

# backend / frontend のレプリカ数。gateway はこの値から転送先を並べ、レプリカ単位のヘルスチェックで振り分ける。
# backend を増やすときは SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE（既定 10）× BACKEND_REPLICAS が
# PostgreSQL の max_connections（既定 100）に収まるようにする
BACKEND_REPLICAS=1
FRONTEND_REPLICAS=1

# レプリカ一台あたりのメモリ上限（docker の表記: 512m, 1536m など）。backend のヒープはこの 16%〜33% に追従する（既定で約 246〜508MiB）。
# backend はヒープ外に約 410MiB、添付の一時ファイルに最大 128MiB を使うので 1536m 未満にしない。上限を超えるとカーネルに強制終了される。
# 同じホストのレプリカの合計がホストのメモリに収まるようにする。0 は上限なしで、ヒープがホストのメモリの 1/3 まで育つので使わない
BACKEND_MEMORY_LIMIT=1536m
FRONTEND_MEMORY_LIMIT=512m
# backend の JVM オプションの追加・上書き。イメージの既定（-XX:InitialRAMPercentage=16 -XX:MaxRAMPercentage=33 -XX:+UseG1GC）の
# 後に読まれ、同じオプションはこちらが勝つ。JAVA_TOOL_OPTIONS はイメージの既定を丸ごと置き換えるので書かない。
# 同じコンテナで数秒ごとに動くヘルスチェックの java にも効くので、ポートを開くもの（JMX・デバッガ）や -javaagent は入れない（unhealthy になる）
# JDK_JAVA_OPTIONS=-XX:MaxRAMPercentage=60 -XX:+HeapDumpOnOutOfMemoryError

# database コンテナと backend が共有する。backend へは compose が SPRING_DATASOURCE_* に写す（接続先は compose の database に固定）。
# release では USER / PASSWORD が必須で、既存ボリュームがある場合は初回起動時と同じ値にする
POSTGRES_DB=kizuna
POSTGRES_USER=kizuna
POSTGRES_PASSWORD=${POSTGRES_PASSWORD:-changeme}

# cache コンテナと backend が共有する（backend へは SPRING_DATA_REDIS_PASSWORD として渡る）。release では必須
REDIS_PASSWORD=${REDIS_PASSWORD:-changeme}

# 公開ストレージ（storage）と backend が共有する（backend へは APP_UPLOAD_ACCESS_KEY / APP_UPLOAD_SECRET_KEY として渡る）。release では必須
S3_ACCESS_KEY=${S3_ACCESS_KEY:-kizuna-storage}
S3_SECRET_KEY=${S3_SECRET_KEY:-changeme}

# 応募者添付の非公開ストレージ（private-storage）。公開側の S3_* とは必ず別の値にする（同じだと backend が起動を拒む）。
# 既知の値を release に持ち込まないよう空にしておく。空なら development は compose の既定値を使い、release は起動を拒む。
# endpoint とバケット名は compose が固定する。release は既定で無効のため、有効化するときだけ APP_PRIVATE_ATTACHMENTS_ENABLED=true を足す。
PRIVATE_S3_ACCESS_KEY=
PRIVATE_S3_SECRET_KEY=

# メール送信の既定経路（システム設定の SMTP が未設定のとき）。release だけが使い、development は compose がこの 6 つを
# 認証なしの mailpit に固定する（.env の値は届かない）
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your@email.example
SPRING_MAIL_PASSWORD=${SPRING_MAIL_PASSWORD:-changeme}
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# 定期処理（応募者の匿名化・ポイント失効・ポイント期限前案内・業務通知の送信）。既定は無効。
# サービス ID は稼働中のシステムで作る行なので、作成後にその id を書いてから有効化する。手順は infrastructure/README.md の「定期処理の有効化」。
# *_CRON は起動時刻を変えるときだけコメントを外す。
# APP_APPLICANT_ANONYMIZATION_ENABLED=true
# APP_APPLICANT_ANONYMIZATION_SERVICE_USER_ID=
# APP_POINTS_EXPIRY_ENABLED=true
# APP_POINTS_EXPIRY_SERVICE_USER_ID=
# APP_POINTS_EXPIRY_NOTICE_ENABLED=true
# APP_POINTS_EXPIRY_NOTICE_SERVICE_USER_ID=
# APP_POINTS_EXPIRY_NOTICE_CRON=0 0 9 * * *
# APP_NOTIFICATION_DELIVERY_ENABLED=true
# APP_NOTIFICATION_DELIVERY_SERVICE_USER_ID=
# APP_NOTIFICATION_DELIVERY_CRON=0 * * * * *

# よく調整する backend の設定（値は application.yml の既定）。必要なものだけコメントを外す
# SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
# SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=2
# SPRING_DATA_REDIS_LETTUCE_POOL_MAX_ACTIVE=8
# SPRING_CACHE_REDIS_TIME_TO_LIVE=600000
# SPRING_JPA_SHOW_SQL=true
# SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=true
# APP_UPLOAD_MAX_FILE_SIZE=10485760
# APP_JWT_ACCESS_EXPIRATION=900000
# APP_JWT_REFRESH_EXPIRATION=1209600000
